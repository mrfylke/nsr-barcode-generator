{
  "name": "@mrfylke/nsr-barcode-generator",
  "version": "1.4.0",
  "description": "A CLI tool and programmatic API to generate PDF files for unique NSR IDs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nsr-barcode": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test"
  },
  "keywords": [
    "cli",
    "api",
    "pdf",
    "barcode",
    "qr-code",
    "nsr",
    "entur",
    "typescript",
    "public-transport"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/xml2js": "^0.4.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "commander": "^15.0.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
