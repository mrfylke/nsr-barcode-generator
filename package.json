{
  "name": "@mrfylke/nsr-barcode-generator",
  "version": "1.1.0",
  "description": "A CLI tool and programmatic API to generate PDF files for unique NSR IDs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nsr-barcode": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test"
  },
  "keywords": [
    "cli",
    "api",
    "pdf",
    "barcode",
    "qr-code",
    "nsr",
    "entur",
    "typescript",
    "public-transport"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/xml2js": "^0.4.14",
    "rimraf": "^5.0.7",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "commander": "^12.1.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
