{
  "name": "nsr-barcode-generator",
  "version": "1.0.0",
  "description": "A CLI tool to count unique IDs from input files",
  "main": "dist/index.js",
  "bin": {
    "nsr-barcode": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "cli",
    "file",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.3",
    "rimraf": "^5.0.7",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pdfkit": "^0.17.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
